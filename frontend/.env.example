# Server-only. Used by Next.js API routes to reach the Express backend.
BACKEND_API_URL=http://localhost:5000/api

# Public checkout/verify URL for the browser. Do not put secrets here.
NEXT_PUBLIC_API_URL=http://localhost:5000

# HMAC secret for public form tokens (32+ characters). Required in production.
FORM_SIGNING_SECRET=

# Shared secret with the Express API (X-Internal-Token). Must match backend INTERNAL_API_SECRET.
INTERNAL_API_SECRET=

# Translation API Keys (Optional: Google Cloud Translation API or DeepL API)
GOOGLE_TRANSLATE_API_KEY=
DEEPL_API_KEY=

# Server-to-server translation token. Leave blank to disable paid translation API.
TRANSLATION_API_SECRET=
# Non-Vercel ingress must overwrite x-novarch-verified-ip for client-specific form limits.
